# 将本文件复制为 configs/local.env，并填写当前机器上的实际路径。
# configs/local.env 包含机器相关配置，不要提交到 Git。

PYTHON=python
BASE_MODEL=/path/to/Qwen3.5-0.8B
CAGUI_ROOT=/path/to/CAGUI
SFT_ADAPTER=
ARTIFACT_ROOT=/path/to/gui-agent-artifacts

# 仅用于坐标修复前训练的旧 adapter；新模型保持为 0。
LEGACY_YX_OUTPUT=0

CUDA_VISIBLE_DEVICES=0
ATTN_IMPLEMENTATION=sdpa
MAX_IMAGE_SIDE=448
HISTORY_WINDOW=4
MAX_UI_BOXES=30
