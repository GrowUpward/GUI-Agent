# Copy this file to configs/local.env and fill in machine-local paths.
# Never commit configs/local.env.

PYTHON=python
BASE_MODEL=/path/to/Qwen3.5-0.8B
CAGUI_ROOT=/path/to/CAGUI
SFT_ADAPTER=
ARTIFACT_ROOT=/path/to/gui-agent-artifacts

# Only enable for adapters trained before the CAGUI [y,x] -> [x,y] fix.
LEGACY_YX_OUTPUT=0

CUDA_VISIBLE_DEVICES=0
ATTN_IMPLEMENTATION=sdpa
MAX_IMAGE_SIDE=448
HISTORY_WINDOW=4
MAX_UI_BOXES=30
